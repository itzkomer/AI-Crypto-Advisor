##########################################################
# AI Crypto Advisor - Server environment
# Copy to `server/.env` and fill in the values you need.
# Every third-party key is OPTIONAL: each integration has a
# curated static fallback so the app never hard-fails.
##########################################################

# ---------- Core ----------
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# ---------- Database ----------
# Local default: SQLite (zero setup).
DATABASE_URL="file:./prisma/dev.db"
#
# Production (PostgreSQL / Supabase / Neon / Render):
#   1. In prisma/schema.prisma change: provider = "postgresql"
#   2. Set DATABASE_URL to your connection string, e.g.
# DATABASE_URL="postgresql://user:password@host:5432/crypto_advisor?schema=public&sslmode=require"
#   3. Supabase poolers also need a direct URL for migrations:
# DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ---------- Auth (REQUIRED) ----------
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---------- Coin prices: CoinGecko (free, no key required) ----------
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
# Optional demo/pro key raises the free rate limit.
COINGECKO_API_KEY=

# ---------- Market news: CryptoPanic (free tier) ----------
# Get a token at https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_BASE=https://cryptopanic.com/api/v1
CRYPTOPANIC_API_TOKEN=

# ---------- Daily AI insight ----------
# Primary provider: OpenRouter (https://openrouter.ai/keys) - has free models.
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
# Sent by OpenRouter for attribution / leaderboards (optional).
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=AI Crypto Advisor

# Secondary provider: Hugging Face Inference API (used if OpenRouter is unset/failing).
HUGGINGFACE_API_BASE=https://api-inference.huggingface.co
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ---------- Crypto meme ----------
MEME_API_BASE=https://meme-api.com
MEME_SUBREDDITS=cryptocurrencymemes,cryptomemes,bitcoinmemes

# ---------- Reliability tuning ----------
# Seconds each upstream response is cached in memory.
CACHE_TTL_PRICES_SECONDS=60
CACHE_TTL_NEWS_SECONDS=300
CACHE_TTL_MEME_SECONDS=600
# Upstream request timeout (ms) before we fall back.
UPSTREAM_TIMEOUT_MS=8000
