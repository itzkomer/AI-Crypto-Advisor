##########################################################
# AI Crypto Advisor - Client environment
# Copy to `client/.env` (or set in Vercel project settings).
# Only VITE_* variables are exposed to the browser bundle.
##########################################################

# Base URL of the API.
#
# Local dev: leave EMPTY. Vite proxies /api -> http://localhost:4000
# (see vite.config.ts), which avoids CORS entirely.
VITE_API_BASE_URL=

# Production example (no trailing slash):
# VITE_API_BASE_URL=https://ai-crypto-advisor-api.onrender.com

# Optional: override the dev proxy target if your API runs elsewhere.
# VITE_DEV_API_TARGET=http://localhost:4000
