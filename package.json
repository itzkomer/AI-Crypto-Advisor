{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "AI Crypto Advisor API - Express + TypeScript + Prisma",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "//": "--- local dev: SQLite, prisma/schema.prisma ---",
    "build": "prisma generate && tsc -p tsconfig.json",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "//prod": "--- production: PostgreSQL, prisma/postgres/schema.prisma ---",
    "build:prod": "npm run schema:check && prisma generate --schema=prisma/postgres/schema.prisma && tsc -p tsconfig.json",
    "db:deploy": "prisma migrate deploy --schema=prisma/postgres/schema.prisma",
    "db:studio:prod": "prisma studio --schema=prisma/postgres/schema.prisma",
    "//schema": "--- keep the generated Postgres schema in sync ---",
    "schema:sync": "node scripts/sync-postgres-schema.mjs",
    "schema:check": "node scripts/sync-postgres-schema.mjs --check",
    "schema:migration": "prisma migrate diff --from-empty --to-schema-datamodel prisma/postgres/schema.prisma --script > prisma/postgres/migrations/0_init/migration.sql",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.11.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
